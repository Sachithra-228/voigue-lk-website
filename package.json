{
  "name": "voigue-redesign",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "admin:set": "node scripts/set-admin.mjs",
    "wp:css": "tailwindcss -c wordpress/tailwind.config.js -i wordpress/voigue-theme/src/input.css -o wordpress/voigue-theme/assets/css/main.css --minify",
    "wp:css:watch": "tailwindcss -c wordpress/tailwind.config.js -i wordpress/voigue-theme/src/input.css -o wordpress/voigue-theme/assets/css/main.css --watch",
    "wp:zip": "npm run wp:css && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-wordpress.ps1",
    "wp:dev": "npx @wp-playground/cli@latest server --port=9400 --blueprint=wordpress/dev/blueprint.json --mount=./wordpress/voigue-theme:/wordpress/wp-content/themes/voigue-theme --mount=./wordpress/voigue-core:/wordpress/wp-content/plugins/voigue-core"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^2.4.3",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.9.5",
    "next": "^16.3.4",
    "nodemailer": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "d3-geo": "^3.1.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "topojson-client": "^3.1.0",
    "typescript": "^5.7.2",
    "world-atlas": "^2.0.2"
  }
}
